# Server
PORT=3000
NODE_ENV=development

# MySQL (wajib; database harus sudah dibuat)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=AniWatchList

# JWT (JWT_SECRET wajib, minimal 16 karakter, jangan dibagikan)
# Buat nilai acak: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_minimal_16_karakter
JWT_EXPIRES_IN=7d

# CORS & cookie
# CORS_ORIGINS: daftar origin frontend dipisah koma, tanpa wildcard
CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE: true/false (default true saat NODE_ENV=production)
COOKIE_SECURE=false
# COOKIE_SAMESITE: lax (default) | strict | none (none wajib COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# Rate limit
# RATE_LIMIT_ENABLED: true (default) | false (jangan false di produksi)
RATE_LIMIT_ENABLED=true
# TRUST_PROXY: jumlah proxy tepercaya di depan server (mis. 1 untuk satu Nginx).
# KOSONGKAN jika server diakses langsung tanpa proxy. Jangan isi dengan "true".
# Tanpa proxy, klien bisa memalsukan header X-Forwarded-For dan lolos dari
# pembatas. Terlalu kecil: semua pengguna tampak satu IP (proxy) dan saling
# memblokir.
TRUST_PROXY=
# Opsional, ubah batas bila perlu (default di kode):
# RATE_LIMIT_<NAMA>_MAX dan RATE_LIMIT_<NAMA>_WINDOW_MIN (menit)
# NAMA: GLOBAL(600/15) LOGIN_EMAIL(5/15) LOGIN_IP(30/15)
#       REGISTER(10/60) CATALOG(60/1) CREATE_ANIME(30/15)