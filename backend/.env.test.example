MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=AniWatchList_test
JWT_SECRET=test-only-secret-not-for-production

# CORS & cookie
# CORS_ORIGINS: daftar origin frontend dipisah koma, tanpa wildcard
CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE: true/false (default true saat NODE_ENV=production)
COOKIE_SECURE=false
# COOKIE_SAMESITE: lax (default) | strict | none (none wajib COOKIE_SECURE=true)
COOKIE_SAMESITE=lax